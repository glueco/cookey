{
  "name": "personal-resource-gateway",
  "version": "1.0.0",
  "description": "Self-hostable Personal Resource Gateway with PoP identity and compatibility-first SDKs",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:proxy\" \"npm run dev:demo\"",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces --if-present",
    "dev:proxy": "npm run dev --workspace=apps/proxy",
    "dev:demo": "npm --prefix examples/demo-target-app run dev",
    "build:proxy": "npm run build --workspace=@glueco/proxy",
    "build:sdk": "npm run build --workspace=packages/sdk",
    "build:demo": "npm --prefix examples/demo-target-app run build",
    "db:generate": "npm run db:generate --workspace=apps/proxy",
    "db:push": "npm run db:push --workspace=apps/proxy",
    "db:migrate": "npm run db:migrate --workspace=apps/proxy",
    "db:studio": "npm run db:studio --workspace=apps/proxy",
    "test": "npm run test --workspaces --if-present",
    "verify:npm-consumer": "node scripts/verify-npm-consumer.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "concurrently": "^9.2.1",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "postcss": "^8.5.26",
    "sharp": "^0.35.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "allowScripts": {
    "esbuild@0.27.2": true,
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "fsevents@2.3.3": true,
    "prisma@5.22.0": true,
    "unrs-resolver@1.11.1": true
  }
}
