{
  "specVersion": "1",
  "id": "llm:groq",
  "name": "Groq",
  "version": "1.2.0",
  "description": "Fast LLM inference via Groq.",
  "homepage": "https://groq.com",
  "resourceType": "llm",
  "adapter": "openai-compatible",
  "config": {
    "baseUrl": "https://api.groq.com/openai/v1",
    "auth": {
      "type": "bearer"
    }
  },
  "allowedHosts": [
    "api.groq.com"
  ],
  "actions": {
    "chat.completions": {
      "method": "POST",
      "path": "/chat/completions",
      "streaming": true,
      "enforce": {
        "model": {
          "rule": "allowedValues",
          "constraint": "allowedModels"
        },
        "max_tokens": {
          "rule": "clampMax",
          "constraint": "maxOutputTokens",
          "default": 4096
        },
        "stream": {
          "rule": "allowFlag",
          "constraint": "allowStreaming"
        },
        "tools": {
          "rule": "forbidField",
          "constraint": "allowTools"
        }
      },
      "usage": {
        "inputTokens": "usage.prompt_tokens",
        "outputTokens": "usage.completion_tokens",
        "totalTokens": "usage.total_tokens",
        "model": "model"
      }
    },
    "models.list": {
      "method": "GET",
      "path": "/models",
      "streaming": false
    }
  },
  "models": [
    "openai/gpt-oss-120b",
    "openai/gpt-oss-20b"
  ],
  "credentials": [
    {
      "name": "apiKey",
      "type": "secret",
      "label": "Groq API key",
      "required": true
    },
    {
      "name": "baseUrl",
      "type": "url",
      "label": "API base URL",
      "required": false
    }
  ],
  "errorMap": {
    "401": "UNAUTHORIZED",
    "429": "RATE_LIMITED",
    "500": "PROVIDER_ERROR",
    "502": "PROVIDER_ERROR",
    "503": "PROVIDER_ERROR"
  },
  "errorCodePath": "error.code",
  "pricing": {
    "openai/gpt-oss-120b": {
      "inputPerMTok": 0.15,
      "outputPerMTok": 0.60
    },
    "openai/gpt-oss-20b": {
      "inputPerMTok": 0.075,
      "outputPerMTok": 0.30
    }
  }
}
