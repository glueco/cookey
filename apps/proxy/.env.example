# Environment Variables for Cookey Gateway Proxy
# Copy this file to .env and fill in the values

# ===========================================
# REQUIRED: Database (Prisma / Postgres)
# Postgres is the only backing service — no Redis needed.
# ===========================================
DATABASE_URL="postgresql://user:password@localhost:5432/gateway?schema=public"

# ===========================================
# REQUIRED: Encryption
# Master key for secrets encryption (32+ bytes, base64 encoded)
# Generate with: openssl rand -base64 32
# ===========================================
MASTER_KEY="generate-a-secure-random-key-here"

# ===========================================
# REQUIRED: Gateway URL
# Base URL for this gateway (used in pairing strings and claim redirects)
# ===========================================
GATEWAY_URL="http://localhost:3000"

# ===========================================
# OPTIONAL: Admin Authentication
# If set, required for admin API endpoints
# If not set, admin endpoints are open in development mode only
# ===========================================
# ADMIN_SECRET="your-admin-secret"

# ===========================================
# OPTIONAL: Cron authentication
# Vercel cron jobs send Authorization: Bearer ${CRON_SECRET}.
# Cron routes reject when this is unset.
# ===========================================
# CRON_SECRET="generate-a-secure-random-string"
