{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd ../.. && npm run build:proxy",
  "installCommand": "cd ../.. && npm install",
  "framework": "nextjs",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ../../packages/ ../../proxy.plugins.ts",
  "crons": [
    {
      "path": "/api/cron/sweep",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/connector-updates",
      "schedule": "30 4 * * *"
    }
  ]
}
